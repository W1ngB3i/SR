# 复制为 .env 后修改：docker compose 会自动读取同目录下的 .env

# JWT 签名密钥（生产必填，缺失时 compose 将拒绝启动）
# 生成方式：openssl rand -base64 48
JWT_SECRET=please-change-me-to-a-long-random-string

# 宿主机暴露端口（前端静态站，容器内固定 80）
USER_FRONTEND_PORT=5173
ADMIN_FRONTEND_PORT=5174

# —— QQ 机器人（选填）——
# AppID 与 Secret 齐备才真正投递消息；任一缺失时系统只记录消息日志，不影响工单流程。
# 取自 QQ 开放平台（q.qq.com）机器人应用的「开发设置」：AppID 与 AppSecret（Secret 同时用于回调验签）。
# 注：旧版的 Token 鉴权平台已弃用，无需再填。
QQ_BOT_APPID=
QQ_BOT_SECRET=
# 沙箱环境（联调阶段设为 true）
QQ_BOT_SANDBOX=false

# 机器人消息里「去申请 / 查看结果 / 去接单」按钮指向的外部地址。
# 必须是玩家与审核员可访问的地址（公网域名或 IP:端口），留空则回落到 localhost。
PUBLIC_SITE_URL=http://localhost:5173
ADMIN_SITE_URL=http://localhost:5174
